# Company Hermes agent — private env template
# Copy to `.env` (mode 0600). Never commit a real `.env`.
# Shared service credentials do not belong here (spec 16.2, 17.3).

# Identity
COMPANY_SLUG=<company>
COMPANY_LEGAL_NAME=<COMPANY_LEGAL_NAME>
COMPANY_DOMAIN=<company-domain>
COMPANY_PROFILE_ID=<IMMUTABLE_PROFILE_ID>
COMPANY_USER_ID=<IMMUTABLE_USER_ID>

# Knowledge / approvals (generic env names; values are placeholders)
COMPANY_KB_MCP_URL=https://agent-services.<PRIVATE_DOMAIN>/mcp/knowledge
COMPANY_KB_TOKEN=<PER_USER_OR_SHORT_LIVED_TOKEN>
COMPANY_APPROVAL_URL=https://agent-services.<PRIVATE_DOMAIN>/approvals
COMPANY_APPROVAL_TOKEN=<PER_USER_OR_SHORT_LIVED_TOKEN>

# Models (D037 / D038)
MODEL_PROVIDER=<MODEL_PROVIDER>
MODEL_ID=<MODEL_ID>
FALLBACK_MODEL_PROVIDER=<FALLBACK_PROVIDER>
FALLBACK_MODEL_ID=<FALLBACK_MODEL_ID>

# GitHub (D042)
GITHUB_ORG=<GITHUB_ORG>
GITHUB_REPO=company-agent-template

# Notion public connection (see docs/notion-setup.md)
NOTION_CLIENT_ID=<NOTION_OAUTH_CLIENT_ID>
NOTION_CLIENT_SECRET=<NOTION_OAUTH_CLIENT_SECRET>
NOTION_REDIRECT_URI=http://127.0.0.1:8080/auth/notion/callback
