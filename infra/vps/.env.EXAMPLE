# VPS knowledge-stack + Hermes runtime env.
# Copy to infra/vps/.env (mode 0600). Never commit real values.

# --- Postgres (Compose service "postgres") ---
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=company_kb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://<postgres-user>:<postgres-password>@postgres:5432/company_kb

# --- Embeddings (DEFAULT for Phase 2) ---
# Lightweight hosted default. Matches services/migrations/0006 vector(1536).
# Changing width later needs a parallel table (spec 14.3 / D056).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=<EMBEDDING_API_KEY>
# Alternatives (set all three + key; then migrate vector width if != 1536):
#   EMBEDDING_PROVIDER=openai   EMBEDDING_MODEL=text-embedding-3-large  EMBEDDING_DIMENSIONS=3072
#   EMBEDDING_PROVIDER=voyage   EMBEDDING_MODEL=voyage-3-lite           EMBEDDING_DIMENSIONS=512
#   EMBEDDING_PROVIDER=google   EMBEDDING_MODEL=text-embedding-004      EMBEDDING_DIMENSIONS=768

# --- Notion (knowledge ingest / connector) ---
NOTION_API_TOKEN=<NOTION_API_TOKEN>
# Optional public OAuth (not required when using a PAT):
NOTION_CLIENT_ID=<NOTION_OAUTH_CLIENT_ID>
NOTION_CLIENT_SECRET=<NOTION_OAUTH_CLIENT_SECRET>
NOTION_REDIRECT_URI=https://<DOMAIN>/auth/notion/callback

# --- Hermes / dashboard auth ---
# Same value as dashboard.company_auth.secret in ~/.hermes/config.yaml
HERMES_DASHBOARD_COMPANY_AUTH_SECRET=<AUTH_SECRET>
AUTH_ISSUER=https://<PRIVATE_IDP>/
AUTH_AUDIENCE=company-agent

# --- Service URLs (in-compose) ---
COMPANY_KB_MCP_URL=http://knowledge-mcp:8082
COMPANY_APPROVAL_URL=http://approval-api:8083
KNOWLEDGE_API_PORT=8081
KNOWLEDGE_MCP_PORT=8082
APPROVAL_API_PORT=8083

# --- Object store / ops ---
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_ROOT=/data/objects
APP_ENV=production
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=30
AUDIT_POLL_SECONDS=30
