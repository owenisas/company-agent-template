[Unit]
Description=Company agent webui (reserved)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<service-user>
Group=<service-user>
WorkingDirectory=/opt/company-agent/webui
EnvironmentFile=-/opt/company-agent/infra/.env
# ExecStart=/usr/local/bin/company-webui
ExecStart=/bin/true
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
