# Copy to webui.env (mode 0600). Never commit a real SECRET_KEY.

SECRET_KEY=
WEBUI_ADMINS=<admin>
WEBUI_PORT=8080
WEBUI_BIND=0.0.0.0
WEBUI_SECURE_COOKIE=0

HERMES_BIN=hermes
HERMES_PROVIDER=xai-oauth
HERMES_MODEL=grok-4.6
HERMES_REASONING_EFFORT=extra-high

# Notion public connection (docs/notion-setup.md). Never put tokens here.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:8080/auth/notion/callback
